<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="color-scheme" content="light"><title><%= survey.title %> - <%= siteName %></title><link rel="icon" href="<%= siteIcon || defaultSiteIcon %>"><link rel="stylesheet" href="/static/styles.css"></head>
<body class="survey-body" data-theme="system" style="--questra-theme-color:<%= themeColor || '#0D9488' %>">
  <main class="survey-shell">
    <div class="survey-theme-control" role="group" aria-label="问卷页面主题"><button type="button" data-theme-choice="light" title="浅色" aria-label="浅色">☀</button><button type="button" data-theme-choice="dark" title="深色" aria-label="深色">☾</button><button type="button" data-theme-choice="system" title="跟随系统" aria-label="跟随系统">◐</button></div>
    <header class="survey-intro"><h1><%= survey.title %></h1><% if (survey.description) { %><p><%= survey.description %></p><% } %><div class="survey-meta"><span><%= survey.questions.length %> 道题</span><% if (survey.kind === 'exam') { %><span>满分 <%= survey.maxScore %> 分</span><% } %><% if (survey.expiresAt) { %><span>截止 <%= new Date(survey.expiresAt).toLocaleString('zh-CN', { hour12: false }) %></span><% } %></div></header>
    <% if (accessDenied) { %>
      <section class="message-box"><h2><%= viewer && viewer.authenticated ? '暂时无法填写' : '请登录后填写' %></h2><p>该问卷要求登录或验证邮箱后才能访问。</p><a class="button primary" href="/user/login?returnTo=<%= encodeURIComponent('/s/' + survey.id) %>">登录</a><a class="button" href="/user/register?returnTo=<%= encodeURIComponent('/s/' + survey.id) %>">注册账户</a></section>
    <% } else { %><form id="public-survey-form" data-survey-id="<%= survey.id %>" data-kind="<%= survey.kind %>">
      <% survey.questions.forEach((question, index) => { %>
        <fieldset class="question-block" data-question-id="<%= question.id %>" data-type="<%= question.type %>">
          <legend><span class="question-number"><%= String(index + 1).padStart(2, '0') %></span><%= question.title %><% if (question.required) { %><em>必填</em><% } %><% if (survey.kind === 'exam' && question.type !== 'open_text') { %><small><%= question.points.toFixed(2).replace(/\.00$/, '') %> 分</small><% } %></legend>
          <% if (question.type === 'text' || question.type === 'open_text') { %>
            <textarea name="q_<%= question.id %>" rows="4" maxlength="10000" <%= question.required ? 'required' : '' %> placeholder="请输入你的回答"></textarea>
          <% } else { question.options.forEach((option, optionIndex) => { %>
            <label class="option-row"><input type="<%= question.type === 'single' ? 'radio' : 'checkbox' %>" name="q_<%= question.id %>" value="<%= option %>" <%= question.required && question.type === 'single' && optionIndex === 0 ? 'required' : '' %>><span><%= option %></span></label>
          <% }) } %>
        </fieldset>
      <% }) %>
      <p id="submit-error" class="form-error"></p><button class="button primary submit-button" type="submit"><%= survey.kind === 'exam' ? '提交试卷' : '提交答卷' %></button>
    </form><% } %>
    <section id="thank-you" class="thank-you" hidden><span class="success-mark">✓</span><h2 id="result-title">感谢参与</h2><p id="result-message">你的答卷已成功提交。</p><div id="exam-score" class="exam-score" hidden><strong id="score-value">0</strong><span> / <b id="max-score-value">0</b> 分</span></div></section>
  </main>
  <%- include('partials/site-footer') %>
  <script src="/static/survey.js"></script>
  <script>
    (() => {
      const body = document.body;
      const key = 'questra-survey-theme';
      const choices = [...document.querySelectorAll('[data-theme-choice]')];
      const apply = (value) => {
        const dark = value === 'dark' || (value === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        body.dataset.theme = dark ? 'dark' : 'light';
        choices.forEach((button) => button.classList.toggle('active', button.dataset.themeChoice === value));
      };
      let value = localStorage.getItem(key) || 'system';
      apply(value);
      choices.forEach((button) => button.addEventListener('click', () => { value = button.dataset.themeChoice; localStorage.setItem(key, value); apply(value); }));
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { if (value === 'system') apply(value); });
    })();
  </script>
</body>
</html>
