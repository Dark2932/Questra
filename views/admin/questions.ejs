<%- include('../partials/admin-head', { title: '题库', current: 'questions', siteName, siteIcon, siteIconAsInitial, siteInitial, siteInitialColor, themeColor }) %>
  <div class="page-heading">
    <div><p class="eyebrow">QUESTION BANK</p><h1>题库</h1></div>
    <button class="button primary" type="button" data-open-question>添加题目</button>
  </div>

  <section class="panel">
    <div class="section-title"><div><h2>公共题目模板</h2><p>问卷生成时会复制题目，之后修改不会影响已有问卷。</p></div></div>
    <div id="question-list" class="item-list"><p class="loading">正在加载…</p></div>
  </section>

  <dialog id="question-dialog">
    <form id="question-form" method="dialog">
      <div class="dialog-head"><h2 id="question-form-title">添加题目</h2><button class="icon-button" type="button" data-close aria-label="关闭">×</button></div>
      <input type="hidden" name="id">
      <label>题目标题<input name="title" maxlength="500" required placeholder="请输入题目内容"></label>
      <label>题目类型
        <select name="type">
          <option value="single">单选</option><option value="multiple">多选</option><option value="judgment">判断</option><option value="text">填空</option><option value="open_text">开放文本</option>
        </select>
      </label>
      <label id="options-field">选项（每行一个）<textarea name="options" rows="5" placeholder="选项 A&#10;选项 B"></textarea></label>
      <fieldset id="correct-choice-field" class="answer-field">
        <legend>标准答案（考试使用）</legend>
        <div id="correct-choice-options" class="answer-options"><p class="empty-note">请先填写选项。</p></div>
      </fieldset>
      <label id="correct-text-field" class="answer-field">可接受的标准答案（每行一个）
        <textarea name="correctText" rows="4" placeholder="允许配置多个等价答案"></textarea>
      </label>
      <p class="field-help">不设置标准答案的题目仍可用于普通问卷，但不能加入考试。</p>
      <p id="question-error" class="form-error"></p>
      <div class="dialog-actions"><button class="button" type="button" data-close>取消</button><button class="button primary" type="submit">保存</button></div>
    </form>
  </dialog>
<%- include('../partials/admin-foot') %>
