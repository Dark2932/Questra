{
  "name": "questra",
  "version": "0.2.0",
  "description": "面向个人开发者的轻量级自托管问卷框架",
  "author": "Dark2932",
  "type": "commonjs",
  "main": "src/app.js",
  "bin": {
    "questra": "bin/questra.js"
  },
  "files": [
    "docs",
    "bin/questra.js",
    "src/**/*.js",
    "views/**/*.ejs",
    "public/**/*",
    "migrations/**/*.sql",
    "client/dist/**/*",
    "survey.config.example.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dark2932/Questra.git"
  },
  "homepage": "https://github.com/Dark2932/Questra#readme",
  "bugs": {
    "url": "https://github.com/Dark2932/Questra/issues"
  },
  "scripts": {
    "start": "node bin/questra.js start",
    "migrate": "node bin/questra.js migrate",
    "dev": "node --watch bin/questra.js start --foreground",
    "test": "node --test \"test/*.test.js\"",
    "test:client": "npm test --prefix client",
    "lint": "eslint src bin scripts test",
    "lint:client": "npm run lint --prefix client",
    "format": "prettier --write \"src/**/*.js\" \"bin/**/*.js\"",
    "install:client": "npm ci --prefix client",
    "build": "npm run build:client",
    "build:client": "node scripts/build-client.js",
    "dev:client": "npm run dev --prefix client",
    "dev:all": "concurrently -k -n server,client \"node --watch bin/questra.js start --foreground\" \"npm run dev --prefix client\"",
    "check:repo": "node scripts/check-repository.js",
    "check": "npm run check:repo && npm run lint && npm test && npm run lint:client && npm run test:client",
    "release:check": "npm run check && npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "prepack": "node scripts/build-client.js --prepack"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "keywords": [
    "survey",
    "questionnaire",
    "sqlite",
    "self-hosted"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "commander": "^14.0.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.4",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6"
  }
}
